# Secret configured on the GitHub webhook / GitHub App. Required.
GITHUB_WEBHOOK_SECRET=change-me

# Comma-separated handlers to run. Each entry is a registered name
# (built-in or "prharness.handlers" entry point) or a "module:attr" path.
HANDLERS=log

# Comma-separated pull_request actions to dispatch ("*" for all).
PR_ACTIONS=opened,synchronize,reopened,ready_for_review
IGNORE_DRAFTS=false

# Per-handler timeout in seconds.
HANDLER_TIMEOUT_SECONDS=30

# Settings for the built-in "forward" handler.
FORWARD_URL=
FORWARD_SECRET=

# Settings for the built-in "code_review" AI agent (HANDLERS=log,code_review).
# Keep real values in .env (gitignored) or your deployment's secret store.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# OPENAI_BASE_URL=           # optional, for OpenAI-compatible endpoints
GITHUB_TOKEN=                # token with "Pull requests: write" + "Contents: read" on the repo
# GITHUB_API_URL=https://api.github.com
# GITHUB_REVIEWER_LOGIN=      # login reviews are posted as; needed for GitHub App tokens (e.g. my-app[bot])
# REVIEW_MAX_DIFF_CHARS=120000
# REVIEW_MAX_FILE_READS=10
# REVIEW_MAX_TURNS=8
# REVIEW_MAX_COMMENTS=25

# Settings for the built-in "security_review" agent. Run it after code_review with
# HANDLERS=log,code_review>security_review  (">" = run in sequence).
# SECURITY_MODEL=gpt-5.5      # empty = use OPENAI_MODEL
# SECURITY_TIMEOUT_SECONDS=300
# SEMGREP_ENABLED=true
# SEMGREP_BIN=semgrep         # path to the semgrep CLI (installed separately)
# SEMGREP_CONFIG=p/default    # comma-separated registry rulesets or local rule files

# Settings for the built-in "dependency_review" agent (uses SECURITY_MODEL).
# DEPENDENCY_MAX_PACKAGES=100
# OSV_API_URL=https://api.osv.dev
# PYPI_URL=https://pypi.org
# NPM_REGISTRY_URL=https://registry.npmjs.org
# GO_PROXY_URL=https://proxy.golang.org

# Semgrep packs for the built-in "infra_review" agent (CI/CD, Docker, Terraform, Kubernetes).
# INFRA_SEMGREP_CONFIG=p/github-actions,p/dockerfile,p/terraform,p/kubernetes

# Size limits used by the built-in "hygiene_review" agent.
# HYGIENE_MAX_CHANGED_LINES=500
# HYGIENE_MAX_FILES=25

LOG_LEVEL=INFO
