# Secret configured on the GitHub webhook / GitHub App. Required.
GITHUB_WEBHOOK_SECRET=change-me

# Comma-separated handlers to run. Each entry is a registered name
# (built-in or "prharness.handlers" entry point) or a "module:attr" path.
HANDLERS=log

# Comma-separated pull_request actions to dispatch ("*" for all).
PR_ACTIONS=opened
IGNORE_DRAFTS=false

# Per-handler timeout in seconds.
HANDLER_TIMEOUT_SECONDS=30

# Settings for the built-in "forward" handler.
FORWARD_URL=
FORWARD_SECRET=

# Settings for the built-in "code_review" AI agent (HANDLERS=log,code_review).
# Keep real values in .env (gitignored) or your deployment's secret store.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=           # optional, for OpenAI-compatible endpoints
GITHUB_TOKEN=                # token with "Pull requests: write" + "Contents: read" on the repo
# GITHUB_API_URL=https://api.github.com
# REVIEW_MAX_DIFF_CHARS=120000
# REVIEW_MAX_FILE_READS=10
# REVIEW_MAX_TURNS=8
# REVIEW_MAX_COMMENTS=25

LOG_LEVEL=INFO
